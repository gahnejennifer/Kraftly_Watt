# MALL – nginx-imagen fyller i ${PORT}, ${API_URL} och ${API_KEY} från miljön när
# containern startar. Saknas en variabel vägrar nginx starta.
server {
  listen ${PORT};
  root /usr/share/nginx/html;
  index index.html;

# NY: säkerhetsheaders för alla locations som inte har egna add_header (/ och /api/)
  include /etc/nginx/security-headers.conf;

  location / {
    try_files $uri $uri/ /index.html;
  }
# --- Cache-headers -------------------------------------------------------
  # Vite döper byggda filer efter innehållet: /assets/index-3f9c2e1a.js. Ändras
  # innehållet byts namnet, så filen kan cachas i ett år utan att någon ser
  # gammal kod. "immutable" säger åt browsern att inte ens fråga om den ändrats.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    include /etc/nginx/security-headers.conf;
  }

  # Ingångarna får ALDRIG fastna i cache: det är de som pekar på de hashade filerna.
  # no-cache = spara gärna, men fråga servern innan du använder kopian (ETag/304).
  # index.html: annars ser användaren gamla filnamn efter en deploy.
  # config.js:  annars slår en flagga inte igenom förrän cachen går ut.
  # version.txt: annars ljuger den för pipelinen och för er själva.
  location = /index.html { add_header Cache-Control "no-cache";include /etc/nginx/security-headers.conf; }
  location = /config.js  { add_header Cache-Control "no-cache";include /etc/nginx/security-headers.conf; }
  location = /version.txt { add_header Cache-Control "no-cache";include /etc/nginx/security-headers.conf;}
  
  # Bara API v2 skickas vidare – och nyckeln läggs på här, på servern.
  # Appen anropar bara /api/v2/. v1 kräver ingen inloggning och lämnar ut kunddata
  # till vem som helst som når proxyn, så den stängs här i stället för att litas på.
  location /api/v2/ {
    proxy_pass ${API_URL}/api/v2/;
    proxy_set_header X-Api-Key ${API_KEY};
    proxy_ssl_server_name on;   # krävs när API_URL är https
    proxy_read_timeout 90s;     # test-API:t kan sova – första anropet tar upp mot en minut
  }

  # Allt annat under /api/ (v1) går aldrig vidare till API:t.
  location /api/ {
    default_type application/json;
    return 410 '{"error":"API v1 är avvecklad – använd /api/v2"}';
  }
}